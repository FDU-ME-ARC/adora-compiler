module {
  func.func @normal_store_route(%value: i32, %output: memref<16xi32>) {
    %index = arith.constant 0 : index
    ADORA.kernel {
      memref.store %value, %output[%index] : memref<16xi32>
      ADORA.terminator
    } {KernelName = "normal_store_route"}
    return
  }

  func.func @store_block_arg(%value: i32, %index: index,
                             %output: memref<16xi32>) {
    ADORA.kernel {
      memref.store %value, %output[%index] : memref<16xi32>
      ADORA.terminator
    } {KernelName = "store_block_arg"}
    return
  }

  func.func @store_index_cast(%value: i32, %raw_index: i32,
                              %output: memref<16xi32>) {
    ADORA.kernel {
      %index = arith.index_cast %raw_index : i32 to index
      memref.store %value, %output[%index] : memref<16xi32>
      ADORA.terminator
    } {KernelName = "store_index_cast"}
    return
  }

  func.func @store_constant_data(%index: index, %output: memref<16xi32>) {
    %value = arith.constant 7 : i32
    ADORA.kernel {
      memref.store %value, %output[%index] : memref<16xi32>
      ADORA.terminator
    } {KernelName = "store_constant_data"}
    return
  }
}
